  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^5.0.7",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.9.3",
